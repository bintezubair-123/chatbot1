# ── Copy this file to .env and fill in real values ─────────────────────────
# Never commit .env to git.

# ── AI / LLM ───────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=groq/compound-mini

# ── Payments (Stripe) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# ── Authentication ─────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_64_char_string

# ── Environment ────────────────────────────────────────────────────────────
# Set to "production" on Railway/Render — enables Secure cookies + strict CORS
ENVIRONMENT=development

# ── CORS (backend) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production: your Vercel URL, e.g. https://merrys-way.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database (optional override) ───────────────────────────────────────────
# Default: python_code/api/users.db
# On Railway with a volume mount, set to /data/users.db
AUTH_DB_PATH=

# ── Vector DB (optional) ───────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
